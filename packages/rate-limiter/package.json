{
  "name": "@challenge/rate-limiter",
  "version": "0.1.0",
  "description": "Redis-backed rate limiting for Express (fixed window + sliding log, per-endpoint and per-tier limits, temporary overrides) with an OpenAPI-first demo API. Tests run against real Redis over a real HTTP server.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "openapi:types": "openapi-typescript openapi.yaml -o src/demo/generated/openapi.d.ts",
    "dev": "tsx watch src/demo/server.ts",
    "start": "node dist/demo/server.js",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "openapi:check": "openapi-typescript openapi.yaml -o /tmp/openapi.check.d.ts >/dev/null && cmp -s /tmp/openapi.check.d.ts src/demo/generated/openapi.d.ts || { echo 'Generated OpenAPI types are stale: run npm run openapi:types'; exit 1; }"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-openapi-validator": "^5.6.2",
    "ioredis": "^6.0.0",
    "path-to-regexp": "^8.4.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "openapi-types": "^12.1.3",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
