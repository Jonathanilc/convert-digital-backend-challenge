# Demo server configuration. Every value is optional; defaults shown.
PORT=3000
REDIS_URL=redis://localhost:6379

# Default algorithm: fixed-window | sliding-log (endpoint rules may override it)
RATE_LIMIT_ALGORITHM=fixed-window

# Default limits per tier (requests per window, window in ms)
UNAUTH_LIMIT=100
UNAUTH_WINDOW_MS=3600000
AUTH_LIMIT=200
AUTH_WINDOW_MS=3600000

# Demo users as id:password:token, comma separated
DEMO_USERS=alice:wonderland:alice-token,bob:builder:bob-token

# Required X-Admin-Token header value for /admin/*
ADMIN_TOKEN=admin-secret

# Express "trust proxy": false | true | <hop count> | <trusted addresses>
TRUST_PROXY=false

# What to do when Redis is unreachable: open (allow) | closed (503)
FAILURE_POLICY=open

# Validate responses against openapi.yaml (defaults to true outside NODE_ENV=production)
VALIDATE_RESPONSES=true

# Redis key layout
KEY_PREFIX=rl
OVERRIDES_KEY=rl:overrides
OVERRIDES_REFRESH_MS=5000
