# Chat server configuration. Every value is optional; defaults shown.
PORT=3001
REDIS_URL=redis://localhost:6379

# SQLite database file (created on first start). Use a persistent volume in production.
DATABASE_FILE=./data/chat.db

# HS256 secret for JWTs. Required (and must not be the default) when NODE_ENV=production.
JWT_SECRET=dev-only-change-me
JWT_TTL_SECONDS=43200

# Seeded accounts as username:password:role, comma separated (role = user | admin)
SEED_USERS=admin:admin-password:admin,alice:wonderland:user,bob:bob-builder:user

# Message rate limit per user (sliding log)
MESSAGE_LIMIT=10
MESSAGE_WINDOW_MS=10000

# Login attempts per IP (fixed window)
LOGIN_LIMIT=5
LOGIN_WINDOW_MS=900000

# Platform header carrying the real client IP (e.g. Fly-Client-IP); unset = socket address
CLIENT_IP_HEADER=
TRUST_PROXY=false
LOG_LEVEL=info
