{
  "name": "convert-digital-backend-challenge",
  "private": true,
  "description": "Backend coding challenge submission. Option 1 (API rate limiter) lives in packages/rate-limiter; the workspace is laid out so Option 2 (WebSocket chat server) can be added as a sibling package.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "docker compose up --build",
    "dev:down": "docker compose down",
    "test": "docker compose run --rm --build test",
    "test:host": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:smoke": "docker compose -f compose.prod.yaml run --rm --build smoke",
    "prod:up": "docker compose -f compose.prod.yaml up --build --wait app",
    "prod:down": "docker compose -f compose.prod.yaml down -v",
    "redis:up": "docker compose up -d redis",
    "redis:down": "docker compose down",
    "check": "npm run format:check && npm run openapi:check && npm run typecheck && npm run test:host",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "openapi:types": "npm run openapi:types --workspaces --if-present",
    "openapi:check": "npm run openapi:check --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
